# Copy to .env and edit locally. Never commit populated secrets.
# Integrations below are reserved unless noted. Demo authentication and payments
# remain unchanged; the web tracker uses OpenFreeMap with simulated locations.
# No secret belongs in VITE_* variables, native apps, or browser code.
#
# Supported syntax: KEY=value, KEY="value", KEY='value', full-line # comments.
# Values are literal: no variable expansion, shell commands, multiline values,
# inline comments, or escaping. Existing process environment variables win.

# Active local-stack settings. Keep HOST and PORT unset: each service has its own.
COOKIST_DB=.data/cookist.db
COOKIST_CATALOG=shared/catalog.json
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Reserved: the web app currently uses this public style directly, not this variable.
# OpenFreeMap needs no API key; attribution must remain visible.
# Map tiles/styles do not include geocoding, routing, or GPS tracking.
OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Stripe TEST/SANDBOX credentials only for the future integration.
# Publishable keys may reach clients; secret and webhook keys must stay server-side.
# Obtain from your Stripe dashboard / CLI and paste only into the local .env.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Address autocomplete / geocoding: provider not yet selected.
GEOCODING_PROVIDER=
GEOCODING_BASE_URL=
GEOCODING_API_KEY=

# Driving routes / ETA: provider not yet selected.
ROUTING_PROVIDER=
ROUTING_BASE_URL=
ROUTING_API_KEY=

# Transactional email: provider not yet selected.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# SMS and push: providers not yet selected; use separate credentials.
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=
PUSH_PROVIDER=
PUSH_CREDENTIALS_FILE=

# Production authentication: future OIDC provider, not the current demo sessions.
# Client IDs/issuer are public metadata; client secret is server-side only.
# A public SPA/mobile client must use authorization code + PKCE, not this secret.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
