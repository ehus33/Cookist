# Copy to .env and edit locally. Never commit populated secrets.
# Supported syntax: KEY=value, quoted values, blank lines, and full-line comments.
# Existing process environment variables take precedence; blank values are ignored.

# For a hosted gateway, set this to the exact HTTPS origin, without a trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Experimental Cognito configuration. These values are public, not secrets.
# Set COOKIST_AUTH_MODE and VITE_AUTH_MODE together for local web builds.
COOKIST_AUTH_MODE=demo
COOKIST_COGNITO_ISSUER=
COOKIST_COGNITO_CLIENT_IDS=
VITE_AUTH_MODE=demo
VITE_COGNITO_ISSUER=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=

# Managed deployments are disabled by default and require Cognito authentication,
# a dedicated scoped AWS identity, and a private persistent state directory.
COOKIST_DEPLOYMENTS_ENABLED=false
COOKIST_DEPLOYMENT_OWNER=
# Optional absolute path to a private, administrator-managed access-policy JSON.
# Empty means owner-only. Containers need the file mounted read-only at this path.
COOKIST_DEPLOYMENT_ACCESS_FILE=
# Hosted enforces subscriptions; local bypasses only subscription checks.
# Local mode requires the gateway's HOST to be a loopback IP, such as 127.0.0.1.
# It never bypasses authentication, roles, ownership, or quotas. Compose stays hosted.
COOKIST_DEPLOYMENT_ACCESS_MODE=hosted

# Stripe hosted subscription checkout. Leave disabled until configured.
# Keep secret values only in private runtime configuration, never source control.
# Create a fixed recurring price in Stripe; do not set amounts from the browser.
COOKIST_BILLING_ENABLED=false
# Opt in to isolated personal tenants for verified users without assigned membership.
COOKIST_SELF_SERVICE_BILLING=false
COOKIST_PUBLIC_ORIGIN=
COOKIST_STRIPE_MODE=test
COOKIST_STRIPE_PRICE_ID=
COOKIST_STRIPE_SECRET_KEY=
COOKIST_STRIPE_WEBHOOK_SECRET=
COOKIST_DEPLOYMENT_ROOT=
COOKIST_TERRAFORM_PATH=
COOKIST_AWS_ACCOUNT_ID=

# Local AWS profile that assumes the scoped worker role (not an admin profile).
AWS_PROFILE=
