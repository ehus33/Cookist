{
  "name": "cookist",
  "version": "0.1.0",
  "private": true,
  "description": "A test-mode marketplace for food prepared in approved shared kitchens.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc && esbuild src/public/main.tsx src/public/admin-entry.tsx --bundle --format=esm --platform=browser --outdir=dist/public --define:process.env.NODE_ENV='\"production\"'",
    "start": "yarn build && node --experimental-sqlite dist/server.js",
    "test": "yarn build && tsc -p tsconfig.tests.json && cross-env NODE_OPTIONS=--experimental-sqlite vitest run --coverage",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-sqlite vitest"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "vitest": "^3.2.0",
    "typescript": "latest"
  }
}
