{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CookistBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:DeleteBucketPolicy",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketLocation",
        "s3:GetBucketLogging",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetBucketWebsite",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:ListBucket",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging"
      ],
      "Resource": "arn:aws:s3:::cookist-${account_id}-*"
    },
    {
      "Sid": "CookistIndexObjects",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:DeleteObjectTagging",
        "s3:GetObject",
        "s3:GetObjectTagging",
        "s3:PutObject",
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:s3:::cookist-${account_id}-*/index.html"
    },
    {
      "Sid": "CreateTaggedDistributions",
      "Effect": "Allow",
      "Action": "cloudfront:CreateDistribution",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestTag/CookistManaged": "test-site" },
        "ForAllValues:StringEquals": { "aws:TagKeys": ["CookistManaged"] }
      }
    },
    {
      "Sid": "TagDistributionAtCreation",
      "Effect": "Allow",
      "Action": "cloudfront:TagResource",
      "Resource": "arn:aws:cloudfront::${account_id}:distribution/*",
      "Condition": {
        "StringEquals": { "aws:RequestTag/CookistManaged": "test-site" },
        "ForAllValues:StringEquals": { "aws:TagKeys": ["CookistManaged"] }
      }
    },
    {
      "Sid": "ReadDistributionDeletionStatus",
      "Effect": "Allow",
      "Action": "cloudfront:GetDistribution",
      "Resource": "*",
      "Condition": {
        "StringEqualsIfExists": { "aws:ResourceAccount": "${account_id}" }
      }
    },
    {
      "Sid": "ManageTaggedDistributions",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "cloudfront:DeleteDistribution",
        "cloudfront:ListTagsForResource"
      ],
      "Resource": "arn:aws:cloudfront::${account_id}:distribution/*",
      "Condition": {
        "StringEquals": { "aws:ResourceTag/CookistManaged": "test-site" }
      }
    },
    {
      "Sid": "CreateOriginAccessControl",
      "Effect": "Allow",
      "Action": "cloudfront:CreateOriginAccessControl",
      "Resource": "*"
    },
    {
      "Sid": "ReadAndDeleteOriginAccessControls",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetOriginAccessControl",
        "cloudfront:DeleteOriginAccessControl"
      ],
      "Resource": "arn:aws:cloudfront::${account_id}:origin-access-control/*"
    }
  ]
}
